    <!--查询student表中所有的数据-->
    <select id="findAll" resultType="org.one.afternoon.domain.Wear">
        SELECT * FROM wear
    </select>



    <!--插入操作-->
    <insert id="insert" parameterType="org.one.afternoon.domain.Wear">
        INSERT INTO wear (listing_id,market_hash_name,market_bucket_group_id, min,max)
        VALUES (#{listingId},#{marketHashName}, #{marketBucketGroupId},#{min},#{max})
    </insert>

    <!--根据id删除-->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM wear WHERE listing_id=#{listingId}
    </delete>

    <!--更新操作-->
    <update id="update" parameterType="org.one.afternoon.domain.Wear">
        UPDATE wear SET
        market_hash_name=#{marketHashName},
        market_bucket_group_id=#{marketBucketGroupId},min=#{min},max=#{max}
        WHERE listing_id=#{listingId}
    </update>
</mapper>